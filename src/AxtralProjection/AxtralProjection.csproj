<Project Sdk="Microsoft.NET.Sdk">
<PropertyGroup><TargetFramework>net48</TargetFramework><AssemblyName>AxtralProjection</AssemblyName><Version>0.2.1</Version><CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies><GameReferences Condition="'$(GameReferences)' == ''">$(MSBuildThisFileDirectory)../../references</GameReferences></PropertyGroup>
<ItemGroup>
<EmbeddedResource Include="exhaustion_icon.png" LogicalName="AxtralProjection.exhaustion_icon.png"/>
<ProjectReference Include="../AxtralProjection.Core/AxtralProjection.Core.csproj"/>
<PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all"/>
<PackageReference Include="JotunnLib" Version="2.30.2" ExcludeAssets="build;buildTransitive;runtime" PrivateAssets="all"/>
<Reference Include="$(GameReferences)/*.dll"><Private>false</Private></Reference>
<Reference Include="BepInEx"><HintPath>../../.deps/BepInEx.dll</HintPath><Private>false</Private></Reference>
<Reference Include="0Harmony"><HintPath>../../.deps/0Harmony.dll</HintPath><Private>false</Private></Reference>
</ItemGroup>
<Target Name="CheckReferences" BeforeTargets="ResolveAssemblyReferences"><Error Condition="!Exists('../../.deps/BepInEx.dll')" Text="Run python3 scripts/prepare-references.py before building."/><Error Condition="!Exists('$(GameReferences)/assembly_valheim.dll')" Text="Supply Valheim 1.0.2 Managed DLLs in references/ or set GameReferences."/></Target>
</Project>
